# Modal backend (modal_app.py -> web function `api`)
MODAL_URL=https://chinesemahim--aigc-detector-api.modal.run
MODAL_API_KEY=            # same value as Modal secret aigc-detector-key / AIGC_KEY

# Optional: set to password-protect the whole site (HTTP Basic). Empty = public.
APP_USER=admin
APP_PASSWORD=

# Optional: comma-separated bearer keys for programmatic API access (skip rate limit)
API_KEYS=

RATE_LIMIT_PER_HOUR=30    # per client IP, web callers only; 0 disables
MAX_UPLOAD_MB=15
